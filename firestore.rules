rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminRef() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn() && exists(adminRef());
    }

    function adminData() {
      return get(adminRef()).data;
    }

    function isSuperAdmin() {
      return isAdmin() && adminData().role == 'super_admin';
    }

    function adminRole() {
      return isAdmin() ? adminData().role : '';
    }

    function isClubAdminLike() {
      return isAdmin() && adminRole() in ['admin', 'club_admin', 'super_admin'];
    }

    function isEventManagerLike() {
      return isAdmin() && adminRole() in ['event_manager', 'admin', 'club_admin', 'super_admin'];
    }

    function isViewerLike() {
      return isAdmin() && adminRole() in ['viewer', 'event_manager', 'admin', 'club_admin', 'super_admin'];
    }

    function sameClub(clubId) {
      return isAdmin() && clubId == adminData().clubId;
    }

    function canonicalClubId(clubId, clubName) {
      return clubId == 'tankhill' ||
        clubName in ['Tankhill', 'tankhill', 'Tankhill City', 'tankhill city']
        ? 'rotaract-tankhill-city'
        : clubId;
    }

    function canonicalClubIdOnly(clubId) {
      return clubId == 'tankhill' ? 'rotaract-tankhill-city' : clubId;
    }

    function canManageClub(clubId) {
      return isSuperAdmin() || sameClub(clubId);
    }

    function canManageCanonicalClub(clubId, clubName) {
      return isSuperAdmin() || (
        isAdmin() &&
        canonicalClubId(clubId, clubName) == canonicalClubId(adminData().clubId, adminData().clubName)
      );
    }

    function canManageAttendanceRecord(attendanceData) {
      return canManageCanonicalClub(attendanceData.clubId, '') || (
        exists(/databases/$(database)/documents/events/$(attendanceData.eventId)) &&
        canManageCanonicalClub(
          get(/databases/$(database)/documents/events/$(attendanceData.eventId)).data.clubId,
          get(/databases/$(database)/documents/events/$(attendanceData.eventId)).data.clubName
        )
      );
    }

    function validRole(role) {
      return role in ['viewer', 'event_manager', 'admin', 'club_admin', 'super_admin'];
    }

    function hasRequiredAttendanceFields() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'clubId',
        'type',
        'personId',
        'personName',
        'personEmail',
        'personPhone',
        'checkedInAt'
      ]);
    }

    function attendanceHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly([
        'eventId',
        'clubId',
        'type',
        'personId',
        'personName',
        'personEmail',
        'personPhone',
        'checkedInAt',
        'eCardGenerated',
        'eCardUrl',
        'isReturningGuest'
      ]);
    }

    function isValidPublicMemberAttendance() {
      return request.resource.data.type == 'member'
        && exists(/databases/$(database)/documents/memberPublicDirectory/$(request.resource.data.personId))
        && canonicalClubIdOnly(
          get(/databases/$(database)/documents/memberPublicDirectory/$(request.resource.data.personId)).data.clubId
        ) == canonicalClubIdOnly(request.resource.data.clubId)
        && get(/databases/$(database)/documents/memberPublicDirectory/$(request.resource.data.personId)).data.isActive == true
        && get(/databases/$(database)/documents/memberPublicDirectory/$(request.resource.data.personId)).data.name == request.resource.data.personName
        && get(/databases/$(database)/documents/memberPublicDirectory/$(request.resource.data.personId)).data.email == request.resource.data.personEmail
        && get(/databases/$(database)/documents/memberPublicDirectory/$(request.resource.data.personId)).data.phone == request.resource.data.personPhone;
    }

    function isValidPublicGuestAttendance() {
      return request.resource.data.type == 'guest'
        && exists(/databases/$(database)/documents/guests/$(request.resource.data.personId))
        && get(/databases/$(database)/documents/guests/$(request.resource.data.personId)).data.clubId == request.resource.data.clubId
        && get(/databases/$(database)/documents/guests/$(request.resource.data.personId)).data.name == request.resource.data.personName
        && get(/databases/$(database)/documents/guests/$(request.resource.data.personId)).data.email == request.resource.data.personEmail
        && get(/databases/$(database)/documents/guests/$(request.resource.data.personId)).data.phone == request.resource.data.personPhone;
    }

    function validPublicAttendanceCreate() {
      return hasRequiredAttendanceFields()
        && attendanceHasOnlyAllowedFields()
        && request.resource.data.eventId is string
        && request.resource.data.clubId is string
        && request.resource.data.type in ['member', 'guest']
        && request.resource.data.personId is string
        && request.resource.data.personName is string
        && request.resource.data.personEmail is string
        && request.resource.data.personPhone is string
        && request.resource.data.checkedInAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['isReturningGuest']) ||
          request.resource.data.isReturningGuest is bool
        )
        && request.resource.data.eCardGenerated == false
        && request.resource.data.eCardUrl == ''
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && canonicalClubIdOnly(
          get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.clubId
        ) == canonicalClubIdOnly(request.resource.data.clubId)
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.isActive == true
        && (
          isValidPublicMemberAttendance() ||
          isValidPublicGuestAttendance()
        );
    }

    function validPublicGuestCreate() {
      return request.resource.data.keys().hasOnly([
          'eventId',
          'clubId',
          'clubName',
          'clubType',
          'clubCode',
          'name',
          'email',
          'phone',
          'type',
          'club',
          'visitCount',
          'lastVisitedOn',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.clubId is string
        && request.resource.data.clubId.size() > 0
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.isActive == true
        && canonicalClubIdOnly(request.resource.data.clubId) == canonicalClubIdOnly(
          get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.clubId
        )
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.type in ['rotarian', 'rotaractor', 'non_rotaractor']
        && request.resource.data.club is string
        && request.resource.data.visitCount == 1
        && request.resource.data.lastVisitedOn is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() && (
        adminId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() && (
        // First admin bootstrap can only self-create as super admin.
        (
          request.auth.uid == adminId &&
          !exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          request.resource.data.role == 'super_admin' &&
          validRole(request.resource.data.role)
        ) ||
        // Existing super admin can create admins for any club.
        (
          isSuperAdmin() &&
          validRole(request.resource.data.role) &&
          request.resource.data.clubId is string &&
          request.resource.data.clubId.size() > 0
        )
      );

      allow update, delete: if isAdmin() && (
        adminId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /clubs/{clubId} {
      allow read: if resource.data.isActive == true || (
        isViewerLike() && (
        isSuperAdmin() ||
        clubId == adminData().clubId
      ));

      allow create, update: if isClubAdminLike() && (
        isSuperAdmin() ||
        clubId == adminData().clubId
      );
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if isViewerLike() && canManageClub(resource.data.clubId);
      allow create: if isClubAdminLike()
        && canManageClub(request.resource.data.clubId)
        && request.resource.data.clubId is string
        && request.resource.data.clubId.size() > 0;
      allow update: if isClubAdminLike()
        && canManageClub(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId;
      allow delete: if isClubAdminLike() && canManageClub(resource.data.clubId);
    }

    match /memberPublicDirectory/{memberId} {
      allow read: if resource.data.isActive == true;
      allow create, update: if isClubAdminLike() && canManageClub(request.resource.data.clubId);
      allow delete: if isClubAdminLike() && canManageClub(resource.data.clubId);
    }

    match /events/{eventId} {
      // Public read is required for scanner/check-in event resolution, but only for active events.
      allow read: if isViewerLike() && canManageClub(resource.data.clubId) || resource.data.isActive == true;
      allow create: if isEventManagerLike()
        && canManageClub(request.resource.data.clubId)
        && request.resource.data.clubId is string
        && request.resource.data.clubId.size() > 0;
      allow update: if isEventManagerLike()
        && canManageClub(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId;
      allow delete: if isEventManagerLike() && canManageClub(resource.data.clubId);
    }

    match /attendance/{attendanceId} {
      allow read: if isViewerLike() && canManageAttendanceRecord(resource.data);
      // Public check-in allowed only when request club matches active event club.
      allow create: if validPublicAttendanceCreate();
      allow update, delete: if isEventManagerLike() && canManageAttendanceRecord(resource.data);
    }

    match /guests/{guestId} {
      allow read: if isViewerLike() && canManageClub(resource.data.clubId);

      // Public create for check-in flow, but only with validated guest payload bound to an active club.
      allow create: if validPublicGuestCreate();

      function isGuestCheckInUpdate() {
        return request.auth == null
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.clubName == resource.data.clubName
          && request.resource.data.clubType == resource.data.clubType
          && request.resource.data.clubCode == resource.data.clubCode
          && request.resource.data.name == resource.data.name
          && request.resource.data.email == resource.data.email
          && request.resource.data.phone == resource.data.phone
          && request.resource.data.type == resource.data.type
          && request.resource.data.club == resource.data.club
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.visitCount == resource.data.visitCount + 1
          && request.resource.data.lastVisitedOn is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      allow update: if isGuestCheckInUpdate() || (isEventManagerLike() && canManageClub(resource.data.clubId));
      allow delete: if isEventManagerLike() && canManageClub(resource.data.clubId);
    }

    match /auditLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.targetClubId == adminData().clubId);
      allow update, delete: if false;
    }

    match /trash/{trashId} {
      allow read, write: if isSuperAdmin();
    }

    match /errorLogs/{errorId} {
      allow create: if isAdmin();
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
